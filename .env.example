# Server
PORT=3000
HOST=0.0.0.0

# Database
# NOTE: You don't need to set this manually. Run `npm run db:setup` and it will
# be set to an absolute path automatically. If you want to override it, use
# a path relative to the project root.
DATABASE_URL=file:./db/custom.db

# Audio Upload
MAX_AUDIO_SIZE=10485760
# Comma-separated MIME types
ALLOWED_AUDIO_TYPES=audio/mpeg,audio/mp3,audio/wav,audio/wave,audio/x-wav,audio/ogg,audio/vorbis

# Queue behavior
DUPLICATE_ALLOWED=false

# Environment
NODE_ENV=development
