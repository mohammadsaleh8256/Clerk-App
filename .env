# Server
PORT=3000
HOST=0.0.0.0

# Database
# NOTE: You can use either a relative path (recommended) or an absolute path.
# - Relative paths are resolved from the project root automatically.
# - On Windows, backslashes are converted to forward slashes for Prisma.
# - The db/ directory is created automatically if it doesn't exist.
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Audio Upload
MAX_AUDIO_SIZE=10485760
# Comma-separated MIME types
ALLOWED_AUDIO_TYPES=audio/mpeg,audio/mp3,audio/wav,audio/wave,audio/x-wav,audio/ogg,audio/vorbis

# Queue behavior
DUPLICATE_ALLOWED=false

# Environment
NODE_ENV=development
