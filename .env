# Server
PORT=3000
# IMPORTANT: Leave HOST as 0.0.0.0 — it makes the server listen on ALL network
# interfaces (loopback + LAN IP). Do NOT change this to a specific IP address
# (e.g. 192.168.1.109), because:
#   - Vite dev proxy connects to http://localhost:3000 (= 127.0.0.1)
#   - If HOST is set to a LAN IP, the server won't listen on 127.0.0.1
#     and the Vite proxy will fail with ECONNREFUSED.
#   - With HOST=192.168.1.109, both 127.0.0.1 and LAN IPs (192.168.x.x) work.
HOST=192.168.1.109

# Database
# NOTE: You can use either a relative path (recommended) or an absolute path.
# - Relative paths are resolved from the project root automatically.
# - On Windows, backslashes are converted to forward slashes for Prisma.
# - The db/ directory is created automatically if it doesn't exist.
# - `npm run db:setup` will rewrite this to an absolute path automatically.
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Audio Upload
MAX_AUDIO_SIZE=10485760
# Comma-separated MIME types
ALLOWED_AUDIO_TYPES=audio/mpeg,audio/mp3,audio/wav,audio/wave,audio/x-wav,audio/ogg,audio/vorbis

# Queue behavior
DUPLICATE_ALLOWED=false

# Environment
NODE_ENV=development
